{
  "name": "byndery",
  "version": "0.0.2",
  "description": "A terminal, file tree and editor in one window, built to sit beside terminal coding agents.",
  "author": {
    "name": "thd2020",
    "url": "https://github.com/thd2020"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/thd2020/byndery.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "tauri icon README.assets/byndery-icon.png -o src-tauri/icons",
    "package:assets": "npm run icons && node scripts/vendor-fonts.mjs --strict && node scripts/vendor-shell.mjs && node scripts/build-handoff.mjs",
    "package": "npm run package:assets && node scripts/bundle-config.mjs && tauri build --config build/tauri.bundle.json && node scripts/collect-packages.mjs",
    "test": "node --test test/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "postinstall": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "type": "module"
}
