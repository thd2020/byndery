{
  "name": "byndery",
  "version": "0.1.0",
  "description": "A terminal, file tree and editor in one window, built to sit beside terminal coding agents.",
  "main": "out/main/index.js",
  "author": {
    "name": "thd2020",
    "url": "https://github.com/thd2020"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/thd2020/byndery.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "e2e": "node test/e2e.mjs",
    "postinstall": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "chokidar": "^4.0.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.19.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
